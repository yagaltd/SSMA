# ─── Server ───────────────────────────────────────────────
SSMA_HOST=127.0.0.1
SSMA_PORT=5050
SSMA_PROTOCOL_SUBPROTOCOL=1.0.0

# ─── Backend adapter ─────────────────────────────────────
SSMA_BACKEND_URL=http://127.0.0.1:6060
SSMA_BACKEND_INTERNAL_TOKEN=
SSMA_BACKEND_TIMEOUT_MS=5000
SSMA_QUERY_MAX_BODY_BYTES=1048576
SSMA_WEBHOOK_MAX_BODY_BYTES=262144

# ─── Auth ─────────────────────────────────────────────────
SSMA_AUTH_JWT_SECRET=            # REQUIRED in production – must be a strong random value
SSMA_AUTH_COOKIE=ssma_session
SSMA_ANON_COOKIE=ssma_anon
SSMA_JWT_ISSUER=ssma-auth-service
SSMA_JWT_AUDIENCE=csma-clients
SSMA_ACCESS_TTL_MS=900000
SSMA_AUTH_COOKIE_SECURE=true

# ─── CORS ─────────────────────────────────────────────────
SSMA_ALLOWED_ORIGINS=            # empty = no CORS headers; set to "https://example.com" as needed

# ─── Rate limiting ────────────────────────────────────────
SSMA_RATE_WINDOW_MS=60000
SSMA_RATE_MAX=120
SSMA_OPTIMISTIC_CHANNEL_WINDOW_MS=10000
SSMA_OPTIMISTIC_CHANNEL_MAX=8
SSMA_OPTIMISTIC_REWORK_WINDOW_MS=60000
SSMA_OPTIMISTIC_REWORK_MAX=20

# ─── Optimistic store ────────────────────────────────────
SSMA_OPTIMISTIC_STORE=./data/optimistic-intents-rust.json
SSMA_OPTIMISTIC_REPLAY_MS=300000
SSMA_OPTIMISTIC_REQUIRE_AUTH_WRITES=false
SSMA_OPTIMISTIC_PROTECTED_CHANNELS=
SSMA_OPTIMISTIC_PROTECTED_CHANNEL_MIN_ROLE=admin
SSMA_OPTIMISTIC_MAX_ENTRIES=5000

# ─── User store ───────────────────────────────────────────
SSMA_USER_STORE=./data/users.json

# ─── Media ────────────────────────────────────────────────
SSMA_MEDIA_STORAGE_ROOT=./data/media
SSMA_MEDIA_MAX_UPLOAD_BYTES=52428800
SSMA_MEDIA_TTL_SECS=3600

# ─── Transport ────────────────────────────────────────────
SSMA_SSE_RETRY_MS=2500
SSMA_WS_MAX_BUFFERED_BYTES=262144

# ─── Logging relay ────────────────────────────────────────
SSMA_LOG_RELAY_URL=

# ─── Form handling ─────────────────────────────────────────
SSMA_FORM_RATE_WINDOW_MS=60000
SSMA_FORM_RATE_MAX=20
SSMA_FORM_MAX_BODY_BYTES=131072
SSMA_FORM_CAPTCHA_MODE=disabled      # disabled|external
SSMA_FORM_CAPTCHA_VERIFY_URL=        # required when mode=external
SSMA_FORM_CAPTCHA_TIMEOUT_MS=3000
SSMA_FORM_CSRF_MODE=disabled         # disabled|double-submit
SSMA_FORM_CSRF_COOKIE=ssma_csrf
SSMA_FORM_CSRF_HEADER=x-csrf-token

# ─── Webhook verification ─────────────────────────────────
SSMA_WEBHOOK_VERIFY_MODE=disabled    # disabled|external
SSMA_WEBHOOK_VERIFY_URL=             # required when mode=external
SSMA_WEBHOOK_VERIFY_TIMEOUT_MS=3000
SSMA_WEBHOOK_IDEMPOTENCY_TTL_SECS=86400

# ─── OIDC bridge ──────────────────────────────────────────
SSMA_OIDC_ENABLED=false
SSMA_OIDC_CLIENT_ID=
SSMA_OIDC_CLIENT_SECRET=
SSMA_OIDC_AUTH_URL=
SSMA_OIDC_TOKEN_URL=
SSMA_OIDC_USERINFO_URL=
SSMA_OIDC_REDIRECT_URL=
SSMA_OIDC_SCOPES=openid profile email
SSMA_OIDC_STATE_TTL_SECS=300
